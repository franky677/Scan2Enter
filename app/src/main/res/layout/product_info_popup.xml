
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/productInfoPopupRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:clipToOutline="false"
    android:elevation="18dp">

    <LinearLayout
        android:id="@+id/productInfoMainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_product_info_header"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="INFORMAZIONI ARTICOLO"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/closeProductInfoButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="7dp"
                android:paddingEnd="9dp"
                android:paddingBottom="7dp">

                <!-- FOTO / DATI / PREZZO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="102dp"
                        android:layout_height="176dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_product_info_field"
                        android:padding="5dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="📦"
                            android:textSize="34sp" />

                        <ImageView
                            android:id="@+id/productImagePlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="Immagine prodotto"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/productFavoriteButton"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_product_info_field"
                                android:contentDescription="Preferito"
                                android:padding="5dp"
                                android:src="@drawable/ic_star_border" />

                            <TextView
                                android:id="@+id/productArticleCodeText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:textColor="#172019"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/productDescriptionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textColor="#172019"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="PREZZO ACQUISTO NETTO"
                            android:textColor="#153F7A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/productPurchaseNetText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="#172019"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fornitore: "
                                android:textColor="#607068"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/productSupplierNameText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#153F7A"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cod. forn.: "
                                android:textColor="#607068"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/productSupplierCodeText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#153F7A"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="136dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_product_info_field"
                        android:orientation="vertical"
                        android:paddingStart="6dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="6dp">

                        <!-- META' SUPERIORE: etichetta e prezzo centrati -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="PREZZO AL PUBBLICO"
                                android:textColor="#153F7A"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/productPublicPriceText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:autoSizeMaxTextSize="54sp"
                                android:autoSizeMinTextSize="26sp"
                                android:autoSizeStepGranularity="1sp"
                                android:autoSizeTextType="uniform"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="#101512"
                                android:textSize="54sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- LINEA DI MEZZERIA -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:background="#D3D9D6" />

                        <!-- META' INFERIORE: imponibile e IVA centrati -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/productTaxablePriceText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textColor="#304C3A"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/productVatRateText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textColor="#304C3A"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- SCORTA/SALUTE A SINISTRA + GIACENZA A DESTRA -->
                <LinearLayout
                    android:id="@+id/productStockCard"
                    android:layout_width="match_parent"
                    android:layout_height="218dp"
                    android:layout_marginTop="7dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_product_info_stock"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <LinearLayout
                            android:id="@+id/productStockStatusContainer"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="0.72"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="5dp"
                            android:visibility="invisible">

                            <TextView
                                android:id="@+id/productStockStatusText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="2"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/productReorderText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Scorta min. "
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/productMinimumStockText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:text="Lotto "
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/productReorderLotValueText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D69A00" />

                        <LinearLayout
                            android:id="@+id/productHealthSection"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1.58"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="5dp"
                            android:paddingTop="1dp"
                            android:paddingEnd="5dp"
                            android:paddingBottom="1dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/productHealthStatusText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/productHealthDetailsText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/productHealthSecondaryText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="124dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_product_info_field"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="GIACENZA"
                            android:textColor="#153F7A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/productStockText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="#101512"
                            android:textSize="54sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Disponibile"
                            android:textColor="#607068"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/productAvailableStockText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="#00843D"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ICONE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_product_info_field"
                    android:orientation="horizontal"
                    android:paddingStart="3dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="3dp"
                    android:paddingBottom="4dp"
                    android:weightSum="6">

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ULT. VEND." android:textColor="#153F7A" android:textSize="7sp" android:textStyle="bold"/>
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="1dp" android:src="@drawable/ic_health_calendar" android:contentDescription="Ultima vendita"/>
                        <TextView android:id="@+id/healthLastSaleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="—" android:textColor="#172019" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VEND. 12M" android:textColor="#153F7A" android:textSize="7sp" android:textStyle="bold"/>
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="1dp" android:src="@drawable/ic_health_chart" android:contentDescription="Vendite 12 mesi"/>
                        <TextView android:id="@+id/healthSold12Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="—" android:textColor="#172019" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROTAZIONE" android:textColor="#153F7A" android:textSize="7sp" android:textStyle="bold"/>
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="1dp" android:src="@drawable/ic_health_rotate" android:contentDescription="Rotazione"/>
                        <TextView android:id="@+id/healthRotationText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="—" android:textColor="#172019" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COPERTURA" android:textColor="#153F7A" android:textSize="7sp" android:textStyle="bold"/>
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="1dp" android:src="@drawable/ic_health_clock" android:contentDescription="Copertura"/>
                        <TextView android:id="@+id/healthCoverageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:text="—" android:textColor="#172019" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MESE" android:textColor="#153F7A" android:textSize="7sp" android:textStyle="bold"/>
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="1dp" android:src="@drawable/ic_health_month" android:contentDescription="Mese"/>
                        <TextView android:id="@+id/productSeasonText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:textColor="#172019" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ANNO" android:textColor="#153F7A" android:textSize="7sp" android:textStyle="bold"/>
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="1dp" android:src="@drawable/ic_health_year" android:contentDescription="Anno"/>
                        <TextView android:id="@+id/productYearText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:textColor="#172019" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- UBICAZIONE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_product_info_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp">

                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:contentDescription="Ubicazione"
                        android:src="@drawable/ic_health_location" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="UBICAZIONE"
                        android:textColor="#153F7A"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/productLocationText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:textColor="#172019"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- BARCODE GRAFICO + EAN NUMERICO MOLTO LEGGIBILE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_product_info_field"
                    android:orientation="vertical"
                    android:paddingStart="3dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="3dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:id="@+id/productBarcodeImage"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:adjustViewBounds="false"
                        android:background="#FFFFFF"
                        android:contentDescription="Codice a barre EAN-13"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/productBarcodeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.16"
                        android:maxLines="1"
                        android:textColor="#101512"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- BARRA FUNZIONI: centro = vero toggle SUONI STOCK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#F7F8F8"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="2"
                android:text="👆 TAP BREVE\nchiudi / scanner"
                android:textColor="#153F7A"
                android:textSize="8sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/popupDurationControl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.2"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingTop="0dp"
                android:paddingEnd="3dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/popupDurationModeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="SUONI STOCK"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/popupDurationValueText"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <SeekBar
                    android:id="@+id/popupDurationSeekBar"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>


            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="2"
                android:text="👆 LONG PRESS PREZZO\nscegli listino"
                android:textColor="#153F7A"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>