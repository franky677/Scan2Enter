<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/locationManagementRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF111111"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvLocationManagementTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="GESTIONE UBICAZIONI"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLocationManagementArticle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#FFCCCCCC"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:maxHeight="360dp">

        <LinearLayout
            android:id="@+id/locationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/tvNoLocations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:padding="12dp"
        android:text="Nessuna ubicazione assegnata"
        android:textColor="#FFCCCCCC"
        android:textSize="16sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnAddLocation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:enabled="false"
        android:text="+ AGGIUNGI"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCloseLocationManagement"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:text="CHIUDI"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>