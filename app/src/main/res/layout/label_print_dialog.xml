<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/labelPrintDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_product_info_header"
        android:paddingStart="18dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="STAMPA ETICHETTE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/closeLabelPrintButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/labelPrintArticleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#172019"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="STAMPANTE"
                android:textColor="#607068"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_product_info_field"
                android:orientation="vertical"
                android:padding="10dp">

                <RadioButton
                    android:id="@+id/godexPrinterRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:checked="true"
                    android:text="GoDEX G500 · 40×13 mm"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/epsonPrinterRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Epson XP-970 · foglio"
                    android:textSize="16sp" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="TIPO ETICHETTA"
                android:textColor="#607068"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_product_info_field"
                android:orientation="vertical"
                android:padding="10dp">

                <RadioButton
                    android:id="@+id/standardLabelRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:checked="true"
                    android:text="Standard"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/imageLabelRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Standard + immagine"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/priceLabelRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Standard + prezzo"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/noteLabelRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Nota personalizzata"
                    android:textSize="16sp" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/noteEditorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_product_info_field"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/noteEditText"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:background="#FFFFFFFF"
                    android:gravity="center"
                    android:hint="Scrivi la nota..."
                    android:inputType="textCapCharacters|textMultiLine"
                    android:maxLength="80"
                    android:maxLines="3"
                    android:minLines="3"
                    android:padding="10dp"
                    android:textColor="#172019"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="QUANTITÀ"
                android:textColor="#607068"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_product_info_field"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <Button
                    android:id="@+id/labelQuantityMinusButton"
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    android:text="−"
                    android:textSize="28sp" />

                <EditText
                    android:id="@+id/labelQuantityEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:background="#FFFFFFFF"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/labelQuantityPlusButton"
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    android:text="+"
                    android:textSize="25sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/labelPrintAvailabilityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="GoDEX: Standard, Immagine, Prezzo e Nota."
                android:textColor="#6B736D"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/cancelLabelPrintButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="ANNULLA"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/confirmLabelPrintButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="STAMPA"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
