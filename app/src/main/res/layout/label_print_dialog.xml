<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/labelPrintDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_product_info_header"
        android:paddingStart="18dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="ETICHETTE GODEX"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/closeLabelPrintButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:text="ARTICOLO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#607068"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/labelPrintArticleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_product_info_field"
                android:ellipsize="end"
                android:maxLines="2"
                android:minHeight="54dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:textColor="#172019"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/searchLabelArticleButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:text="🔎  CERCA ARTICOLO"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="TIPO ETICHETTA"
                android:textColor="#607068"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_product_info_field"
                android:orientation="vertical"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/standardLabelRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:checked="true"
                    android:text="Standard"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/imageLabelRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Con immagine"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/priceLabelRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Con prezzo"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/noteLabelRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Nota personalizzata"
                    android:textSize="15sp" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/noteEditorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_product_info_field"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/noteEditText"
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:background="#FFFFFFFF"
                    android:gravity="center"
                    android:hint="Scrivi la nota..."
                    android:inputType="textCapCharacters|textMultiLine"
                    android:maxLength="80"
                    android:maxLines="3"
                    android:minLines="2"
                    android:padding="8dp"
                    android:textColor="#172019"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="ANTEPRIMA 40 × 13 mm"
                android:textColor="#607068"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginTop="5dp"
                android:background="#FFFDF7"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/labelPreviewCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/labelPreviewDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#111111"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/labelPreviewBarcode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/labelPreviewExtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_product_info_field"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingEnd="8dp"
                    android:text="Q.TÀ"
                    android:textColor="#607068"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/labelQuantityMinusButton"
                    android:layout_width="54dp"
                    android:layout_height="match_parent"
                    android:text="−"
                    android:textSize="26sp" />

                <EditText
                    android:id="@+id/labelQuantityEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="7dp"
                    android:layout_weight="1"
                    android:background="#FFFFFFFF"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/labelQuantityPlusButton"
                    android:layout_width="54dp"
                    android:layout_height="match_parent"
                    android:text="+"
                    android:textSize="23sp" />
            </LinearLayout>

            <Button
                android:id="@+id/confirmLabelPrintButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:text="🖨  STAMPA"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
